{
  "name": "claude-context-bridge",
  "version": "1.0.0",
  "description": "Local MCP server that exposes git repos and Claude Code session context to Claude.ai",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-context-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test-tools": "node dist/index.js --test",
    "test-tools:dev": "tsx src/index.ts --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
